{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/sync-football-scores?mode=live",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/sync-football-scores?mode=full",
      "schedule": "*/8 * * * *"
    }
  ]
}
