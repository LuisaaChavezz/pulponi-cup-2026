VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Obligatorio para npm run sync:worldcup y npm run seed:fifa (upserts masivos).
# Dashboard Supabase → Settings → API → service_role (no exponer en el frontend).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API-Football — solo resultados, estadísticas, eventos y live (NO calendario).
VITE_FOOTBALL_API_KEY=your-api-sports-key
VITE_FOOTBALL_LEAGUE_ID=1
VITE_FOOTBALL_SEASON=2026
