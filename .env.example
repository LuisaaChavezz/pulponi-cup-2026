VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Obligatorio para npm run sync:worldcup y npm run seed:fifa (upserts masivos).
# Dashboard Supabase → Settings → API → service_role (no exponer en el frontend).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API-Football — solo resultados, estadísticas, eventos y live (NO calendario).
VITE_FOOTBALL_API_KEY=your-api-sports-key
# Opcional en servidor (Vercel cron): misma clave sin prefijo VITE_
FOOTBALL_API_KEY=
VITE_FOOTBALL_LEAGUE_ID=1
VITE_FOOTBALL_SEASON=2026

# Cron manual / pruebas locales (Edge Function sync-football-scores)
CRON_SECRET=generate-a-long-random-string

# Supabase Edge Function sync-football-scores (pg_cron cada 5 min)
# Desplegar: supabase functions deploy sync-football-scores
# Secretos:  supabase secrets set FOOTBALL_API_KEY=... VITE_FOOTBALL_LEAGUE_ID=1 VITE_FOOTBALL_SEASON=2026
# pg_cron:   ejecutar supabase/pg_cron_sync_football_scores.sql (Vault: supabase_project_url, supabase_service_role_key)

# Parlay — momios autorizados (The Odds API). Sin scraping ni datos no autorizados.
VITE_THE_ODDS_API_ENABLED=false
# Servidor Vercel (api/odds.js): clave privada, nunca en el bundle del cliente
THE_ODDS_API_KEY=your-the-odds-api-key

# PDF de resultados (generate_pulponi_final.py → api/generate-pdf.py)
# En Vercel el frontend llama a /api/generate-pdf en el mismo dominio (ver vercel.json).
# Opcional si el API está en otro host:
# VITE_PDF_SERVICE_URL=https://tu-app.vercel.app/api/generate-pdf
# Supabase Edge Function generate-match-pdf (secreto del servidor):
# PDF_SERVICE_URL=https://tu-app.vercel.app/api/generate-pdf

# Resend — correos automáticos (Edge Functions send-predictions-email / send-results-email).
# NUNCA commitear la API key. Configurar solo en Supabase:
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxx
# Ejecutar: supabase/email_logs.sql y supabase/pg_cron_send_predictions_email.sql
